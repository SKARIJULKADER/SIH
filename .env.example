# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key

# Optional: pin a specific Gemini model (fallback chain is used otherwise)
# GEMINI_MODEL=gemini-flash-latest

# Video Solution Generator provider (optional until a real provider is connected)
# VIDEO_PROVIDER=
# VIDEO_PROVIDER_API_KEY=

# Smart Job Finder feed providers (comma-separated, order = priority).
# Built-in options: sample (demo data, clearly labeled), remotive, arbeitnow —
# both public official job APIs. Add your own partner-API providers in server/jobs/.
# JOB_PROVIDERS=sample,remotive,arbeitnow
# JOB_FEED_TTL_MINUTES=30
